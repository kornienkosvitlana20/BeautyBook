@model BookingViewModel
@{ ViewData["Title"] = "Новий запис"; var master = (Master)ViewBag.Master; }
<h1>Запис до @master.FullName</h1><form asp-action="Create" method="post" class="form-card"><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="MasterId"/><label>Послуга</label><select asp-for="BeautyServiceId"><option value="">Оберіть послугу</option>@foreach(var s in master.Services){<option value="@s.Id">@s.Name — @s.Price грн (@s.DurationMinutes хв)</option>}</select><span asp-validation-for="BeautyServiceId"></span><label>Дата та час</label><input asp-for="StartAt" type="datetime-local"/><span asp-validation-for="StartAt"></span><button class="btn">Підтвердити запис</button></form>
