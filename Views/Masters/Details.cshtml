@model Master
@{ ViewData["Title"] = Model.FullName; }
<a asp-action="Index">← До списку майстрів</a><section class="profile"><div class="avatar large">@Model.FullName.Substring(0,1)</div><div><p class="eyebrow">@Model.Specialty · @Model.City</p><h1>@Model.FullName</h1><p>@Model.Description</p></div></section><h2>Послуги та ціни</h2><div class="service-list">@foreach(var s in Model.Services){<div class="service"><div><b>@s.Name</b><p>@s.DurationMinutes хвилин</p></div><strong>@s.Price.ToString("0.00") грн</strong></div>}</div><a class="btn" asp-controller="Bookings" asp-action="Create" asp-route-masterId="@Model.Id">Записатися онлайн</a>
