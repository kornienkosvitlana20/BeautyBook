<!DOCTYPE html>
<html lang="uk"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] — BeautyBook</title><link rel="stylesheet" href="~/css/site.css" /></head>
<body><header><a class="brand" asp-controller="Home" asp-action="Index">BeautyBook</a><nav><a asp-controller="Masters" asp-action="Index">Знайти майстра</a>@if(User.Identity?.IsAuthenticated == true){<a asp-controller="Bookings" asp-action="My">Мої записи</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button">Вийти</button></form>}else{<a asp-controller="Account" asp-action="Login">Увійти</a><a asp-controller="Account" asp-action="Register">Реєстрація</a>}</nav></header><main>@RenderBody()</main><footer>© @DateTime.Now.Year BeautyBook · Знайди свого beauty-фахівця</footer></body></html>
